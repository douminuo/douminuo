{
  "manifest_version": 3,
  "name": "도우미누오: 스마트누오 전용 편의성 확장 프로그램",
  "version": "2.0.1",
  "description": "스마트누오 사용자를 위한 편의성 확장 프로그램입니다. 파티 결정력·내구력과 스피드 추월컷 표시, 계산기 자동 입력, 박스에 샘플·파티 저장 및 불러오기, 샘플 텍스트 변환을 지원합니다.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://smartnuo.com/*",
    "https://www.smartnuo.com/*",
    "https://pokeapi.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "환경설정",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://smartnuo.com/*", "https://www.smartnuo.com/*"],
      "js": [
        "styles/nuoTokens.js",
        "styles/prefsModalCss.js",
        "styles/calcPartyRow.js",
        "styles/teamCopyIcons.js",
        "styles/speedPanel.js",
        "styles/sampleCard.js",
        "sampleCardAssets.js",
        "calcFillShared.js",
        "updateToast.js",
        "prefsEntry.js",
        "slotRead.js",
        "teamBuilderShared.js",
        "sampleLibrary.js",
        "calcFill.js",
        "teamBuilderFill.js",
        "teamBuilderInlineAnnot.js",
        "sampleParty.js",
        "regulationSpeedData.js",
        "speedOutspeedCalc.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.css", "popup.js"],
      "matches": ["https://smartnuo.com/*", "https://www.smartnuo.com/*"]
    }
  ]
}
